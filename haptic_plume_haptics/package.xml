<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>haptic_plume_haptics</name>
  <version>0.0.0</version>
  <description>Haptic cue library: parametric risk field, belief well, concentration heaviness</description>
  <maintainer email="prem.pannavit@gmail.com">premmm</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- obstacle_field only. No rclcpp: the cue math is a pure library so it stays
       assertable with plain gtest, the same discipline that makes the geometry
       testable offline. The composer node (C5) is what brings in ROS. -->
  <depend>haptic_plume_drone</depend>
  <depend>eigen</depend>

  <exec_depend>haptic_plume_description</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
