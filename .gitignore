CLAUDE.md

# colcon artifacts. These belong at the WORKSPACE root (~/Projects/ros2_ws),
# never inside a package — see ros2-sim-workflow skill 1. Listed here so a
# stray `colcon build` run from this directory can never be committed.
build/
install/
log/

# Editor / assistant local config
.vscode/
.claude/

# Python / pytest artifacts (regenerated by colcon build and colcon test)
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
