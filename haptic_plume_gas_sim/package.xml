<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>haptic_plume_gas_sim</name>
  <version>0.0.0</version>
  <description>Truth side of the gas sim: analytic gas field plus the lagged, noisy chemical-sensor model</description>
  <maintainer email="prem.pannavit@gmail.com">premmm</maintainer>
  <license>Apache-2.0</license>

  <depend>haptic_plume_core</depend>
  <depend>python3-numpy</depend>

  <depend>rclcpp</depend>
  <depend>haptic_plume_interfaces</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>visualization_msgs</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
