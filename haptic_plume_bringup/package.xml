<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>haptic_plume_bringup</name>
  <version>0.0.0</version>
  <description>Launch files and nodes for starting HapticPlume robot drivers</description>
  <maintainer email="prem.pannavit@gmail.com">premmm</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>haptic_plume_description</exec_depend>
  <exec_depend>haptic_plume_drone</exec_depend>
  <exec_depend>haptic_plume_gas_sim</exec_depend>
  <exec_depend>haptic_plume_gazebo</exec_depend>
  <exec_depend>haptic_plume_teleop</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
